APP_URL=http://localhost:3000
# Leave DATABASE_URL empty to use embedded Postgres (PGlite) in ./.pglite — no Docker needed.
# With Docker: postgres://flowstack:flowstack@localhost:5432/flowstack
DATABASE_URL=
DATABASE_ADMIN_URL=
XERO_MODE=fixtures                 # live | fixtures
XERO_FIXTURE_SET=demo-uk-synthetic # switch to demo-uk once `pnpm xero:record` has run
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/auth/xero/callback
XERO_SCOPES="openid profile email offline_access accounting.settings.read accounting.contacts.read accounting.reports.profitandloss.read accounting.reports.balancesheet.read accounting.reports.trialbalance.read accounting.reports.aged.read accounting.invoices.read accounting.banktransactions.read"
XERO_WEBHOOK_KEY=
TOKEN_ENC_KEY=                     # openssl rand -base64 32
SESSION_SECRET=                    # openssl rand -base64 48
ADMIN_EMAILS=svinujan10@gmail.com
LLM_ENABLED=false
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
CRON_SECRET=
SENTRY_DSN=
HIGH_BAND=0.10
MED_BAND=0.02
MAP_CONFIDENCE_MIN=0.75
FP_GATE=0.15
# --- v1.1 (CHANGES-v1.1.md) ---
XERO_CONNECTION_CAP=5              # Xero plan cap across all businesses: Starter 5, Core 50
PEER_PRICES_ENABLED=false          # OPEN: needs lawyer + Xero partner sign-off (CHANGES §4 item 2)
MONDAY_DIGEST_ENABLED=false        # parked (v1.1 H)
STRIPE_SECRET_KEY=                 # sk_test_ only until prices are decided (CHANGES §4 item 1)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS_JSON=             # {"pro_monthly":"price_...","pro_annual":"price_...","audit":"price_...","audit_waived":"<coupon id>"}
COMPANIES_HOUSE_API_KEY=           # v1.1 L

# NEXT-STEPS P0.2: read-only demo at /demo (guest session on a sample business, 24 hours). Off unless true.
DEMO_ENABLED=false
# Optional: which sample org /demo opens (default: the built-in ecommerce sample, created from fixtures).
DEMO_ORG_ID=
